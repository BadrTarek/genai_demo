# Copy to `.env` and fill in. Never commit `.env`.

APP_ENV=dev
LOG_LEVEL=INFO

# --- Chat model -------------------------------------------------------------------
# Any provider supported by langchain's `init_chat_model`. For Azure AI Foundry's
# OpenAI-compatible endpoint keep `openai` and set OPENAI_BASE_URL below.
LLM_PROVIDER=openai
# Model or deployment name (DEPLOYMENT_NAME is accepted as an alias).
LLM_MODEL=gpt-5.1
# Leave unset for models that only accept their default temperature.
# LLM_TEMPERATURE=0.0

OPENAI_API_KEY=
# e.g. https://<resource>.services.ai.azure.com/openai/v1
OPENAI_BASE_URL=

# --- Embeddings -------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
# Set when the deployment name differs from the model name.
EMBEDDING_DEPLOYMENT_NAME=

# --- Knowledge base ---------------------------------------------------------------
# Folder indexed by default (CLI, and the MCP server on first use).
KNOWLEDGE_BASE_PATH=./requirements
# MCP clients may only index folders inside this root (defaults to KNOWLEDGE_BASE_PATH).
KNOWLEDGE_BASE_ROOT=
INDEXING_ON_STARTUP=true
MAX_FILES_PER_INDEX=1000
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Vector store -----------------------------------------------------------------
# Local on-disk store (one process at a time) ...
QDRANT_PATH=./data/qdrant
# ... or a Qdrant server, required when Copilot's MCP server and the agent run together:
#   docker compose up -d qdrant   ->   QDRANT_URL=http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=business_requirements

# --- Retrieval, guardrails, evaluation --------------------------------------------
MAX_SEARCH_RESULTS=5
# Passages below this cosine similarity are ignored (also keeps the agent on topic).
MIN_RELEVANCE_SCORE=0.3
MAX_QUESTION_CHARS=2000
# Faithfulness judge score an answer needs to be shown to the user.
GROUNDEDNESS_THRESHOLD=0.7
MAX_GENERATION_ATTEMPTS=2
# Score every agent answer online (one extra judge call per answer).
ONLINE_EVALUATION=true

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=etic-genai-demo
