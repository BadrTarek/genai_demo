# Copy to `.env` and fill in. Never commit `.env`.

APP_ENV=dev
LOG_LEVEL=INFO

# Any provider supported by langchain's `init_chat_model`
# (openai, azure_openai, anthropic, google_genai, bedrock, ollama, ...).
# Install the matching integration package, e.g. `pip install -e ".[openai]"`.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_TEMPERATURE=0.0

# Provider credentials (only the one you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=
EMBEDDING_DEPLOYMENT_NAME=
EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_BASE_URL=

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=etic-genai-demo

# Choose local embedded storage or a Qdrant Docker/server instance.
QDRANT_MODE=local
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION_NAME=business_requirements

# SQLite stores users, expiring sign-in sessions, and persistent chat history.
SQLITE_DB_PATH=./data/documents.db

# MCP server: folder indexed by default, and the root it may index under
# (KNOWLEDGE_BASE_ROOT defaults to REQUIREMENTS_DIR).
REQUIREMENTS_DIR=./requirements
KNOWLEDGE_BASE_ROOT=
INDEXING_ON_STARTUP=true
MAX_SEARCH_RESULTS=5

# Guarded RAG agent (MCP `ask_knowledge_base`)
# Passages below this dense cosine similarity are ignored (keeps the agent on topic).
MIN_RELEVANCE_SCORE=0.3
MAX_QUESTION_CHARS=2000
# Groundedness judge score an answer needs before it is shown.
GROUNDEDNESS_THRESHOLD=0.7
MAX_GENERATION_ATTEMPTS=2
