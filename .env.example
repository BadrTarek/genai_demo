# Copy to `.env` and fill in. Never commit `.env`.

APP_ENV=dev
LOG_LEVEL=INFO

# Any provider supported by langchain's `init_chat_model`
# (openai, azure_openai, anthropic, google_genai, bedrock, ollama, ...).
# Install the matching integration package, e.g. `pip install -e ".[openai]"`.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_TEMPERATURE=0.0

# Provider credentials (only the one you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=etic-genai-demo
